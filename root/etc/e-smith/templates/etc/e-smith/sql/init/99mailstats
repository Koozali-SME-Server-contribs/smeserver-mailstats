{
    my $db = $mailstats{DBName} || 'mailstats';
    my $user = $mailstats{DBUser} || 'mailstats_rw';
    my $pass = $mailstats{DBPass} || 'changeme';
    $OUT .= <<END
#! /bin/sh

    if [ ! -d /var/lib/mysql/mailstats ]; then
    /usr/bin/mariadb <<'EOF'
    CREATE DATABASE $db DEFAULT CHARACTER SET utf8 COLLATE utf8_general_ci;
    USE $db;
	CREATE TABLE IF NOT EXISTS SummaryLogs (
		id INT AUTO_INCREMENT PRIMARY KEY,
		Date DATE,
		Hour INT,
		logData TEXT
	);
EOF
    fi
    /usr/bin/mariadb <<'EOF'
    GRANT SELECT, INSERT, UPDATE, DELETE, CREATE ON $db.* TO $user\@localhost identified by '$pass';
    FLUSH PRIVILEGES;
EOF
END
}
