<h2>${title}</h2>
    <table style="border-collapse:collapse;">
        <thead>
            <tr>
                <th tal:repeat="header column_headers">${header}</th>
            </tr>
        </thead>
        <tbody>          
            <tr tal:repeat="item array_2d">
				<td tal:repeat="cell item">${cell}<span tal:condition="repeat.cell.index == 2">%</span></td>
			</tr>

        </tbody>
    </table>

