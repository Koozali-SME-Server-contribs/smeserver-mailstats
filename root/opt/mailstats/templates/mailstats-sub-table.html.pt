<h2>${title}</h2>
    <table border="1">
        <thead>
            <tr>
                <th tal:repeat="header column_headers">${header}</th>
            </tr>
        </thead>
        <tbody>
            <tr tal:repeat="item array_2d">
                <td>${item[0]}</td>
                <td>${item[1]}</td>
                <td>${item[2]}</td>
            </tr>
        </tbody>
    </table>

